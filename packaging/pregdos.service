# PregDos web interface, as a system service.
#
#     sudo useradd --system --home-dir /var/lib/pregdos --create-home \
#         --shell /sbin/nologin --comment "PregDos service account" pregdos
#     sudo install -m 0644 systemd/pregdos.service /etc/systemd/system/pregdos.service
#     sudo chown -R pregdos:pregdos /var/tmp/pregdos      # if runs already exist
#     sudo systemctl daemon-reload && sudo systemctl enable --now pregdos
#     sudo journalctl -u pregdos -f
#
# THE SERVICE ACCOUNT AND `submit_as_user` MUST AGREE.  This unit runs PregDos *as* the
# pregdos account, so `[scheduler] submit_as_user` must be "" -- there is nothing to drop
# privileges to, and `runuser` is root-only, so any other value fails every submission.
# (`submit_as_user = "pregdos"` is for running the web process as root instead.)
#
# The account also needs, on its own:
#   * access to SLURM -- `sudo -u pregdos sbatch --wrap true` must work (munge);
#   * permission to read `[scheduler] prologue`'s module init at a modules site;
#   * ownership of the studies root, and read access to the TLS key if one is configured.

[Unit]
Description=PregDos pregnancy dosimetry web interface
Documentation=https://github.com/Eurados/pregdos
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pregdos
Group=pregdos

# --config is a CLI flag, so a future WSGI server importing pregdos.webserver:app would not
# see it.  The environment variable works for both.
Environment=PREGDOS_CONFIG=/etc/pregdos/config.toml
ExecStart=/opt/pregdos/venv/bin/pregdos-web

# The config file is read once per process: a change to /etc/pregdos/config.toml needs
# `systemctl restart pregdos`, not just a reload.
Restart=on-failure
RestartSec=5

# Modest hardening.  Deliberately NOT PrivateTmp=yes: that gives the unit a private /tmp AND
# a private /var/tmp, which would hide the studies root (/var/tmp/pregdos by default) from
# everything else and discard every run on restart.  If work_dir is moved off /var/tmp,
# PrivateTmp=yes becomes safe and worth adding.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/var/tmp/pregdos

[Install]
WantedBy=multi-user.target
