## PregDos site configuration.
##
## Copy to /etc/pregdos/config.toml and uncomment what you need.  Every key below is shown
## with its built-in default, so an entirely commented-out file behaves exactly like no file
## at all.
##
## Read from, lowest precedence first:
##
##   1. /etc/pregdos/config.toml
##   2. $XDG_CONFIG_HOME/pregdos/config.toml   (falls back to ~/.config)
##   3. the environment
##
## Those two files merge per key.  `pregdos-web --config PATH` or $PREGDOS_CONFIG instead
## REPLACES both, so one deliberate file is the whole story.  Environment variables win over
## every file: TOPAS_BIN, PREGDOS_WORK_DIR, PREGDOS_EXECUTOR, PREGDOS_SECRET_KEY,
## PREGDOS_DEBUG, TOPAS_VERSION, GEANT4_VERSION, TOPAS_G4_DATA_DIR.
##
## An unknown key, an unknown section or a wrong type is a startup error naming this file and
## the key -- a typo here never silently does nothing.
##
## SECURITY: `[scheduler] prologue` is executed by the shell that runs TOPAS.  This file must
## be owned by root and not writable by anyone else (0644).

[paths]

## Where uploaded studies and their runs are kept.  Must be writable by the user running
## PregDos, and on a MULTI-NODE cluster must be on shared storage -- sbatch --chdir resolves
## on the compute node, so a node-local path there means every field starts in a directory
## that is empty or absent and dies immediately.
##
## /var/tmp (not /tmp!) is deliberate: it is persistent disk that survives reboot, and
## systemd-tmpfiles reaps it after ~30 days -- the auto-cleanup we want, since results must be
## downloaded off the server anyway.  /tmp is usually a RAM-backed tmpfs, wiped on reboot and
## stealing memory from the TOPAS workers.
# work_dir = "/var/tmp/pregdos"

## The TOPAS executable: a name to find on PATH, or an absolute path.  If TOPAS lives behind
## `module load`, set [scheduler] prologue below as well -- PATH alone is not enough, TOPAS
## also needs its Geant4 data and LD_LIBRARY_PATH.
# topas_bin = "topas"

## The dicomexport executable.  Empty means autodetect beside the running interpreter, which
## is right for a normal venv install.  Set an absolute path only if it lives elsewhere; a
## wrapper that needs arguments belongs in a shell script, this is not shell-split.
# dicomexport = ""

## Seconds before a hung DICOM conversion is killed.  0 waits forever, which will eventually
## wedge a web worker.
# dicomexport_timeout = 900

[scheduler]

## SLURM submission.  Every string below is EMPTY BY DEFAULT, and empty means the flag is
## omitted from the sbatch line entirely -- so SLURM applies its own site default.  Set one
## only when this site needs something other than that default.

## sbatch --partition
# partition = ""

## sbatch --account
# account = ""

## sbatch --qos
# qos = ""

## sbatch --time, e.g. "04:00:00".  A clinical recalculation is hours, not minutes; if the
## site's default partition limit is short, set this or fields are killed mid-run.
# walltime = ""

## sbatch --mem, e.g. "16G".  A study too large for the node dies as a bare SIGSEGV, so a
## limit that fails the job cleanly at submit is friendlier than one that does not.
# memory = ""

## sbatch --cpus-per-task.  0 means "as many CPUs as the machine running the web process
## reports", which is wrong whenever that machine is not the compute node, or when the
## partition offers fewer -- SLURM then rejects every field job at submit.  Set this to what
## the partition actually allows.  The single-threaded structure-mask pre-pass always asks
## for 1 regardless.
# cpus_per_task = 0

## Which user sbatch is invoked as.
##   "auto"    - drop to the `slurm` account via runuser, but only when running as root.
##               This is the shipped container's behaviour.
##   ""        - never drop privileges; submit as whoever runs PregDos.  This is what a site
##               SLURM wants, where PregDos has its own service account.
##   "<name>"  - drop to that account (again, only when running as root).
# submit_as_user = "auto"

## Shell source run before TOPAS, for sites where TOPAS lives behind environment modules.
##
## APPLIES TO BOTH BACKENDS -- SLURM and the local one -- because PregDos falls back to local
## execution whenever sbatch is not on PATH, and a prologue that silently stopped applying
## there would be a trap.
##
## Both backends use /bin/sh, where `module` is not defined, so source the module init first:
##
# prologue = """
# . /etc/profile.d/modules.sh
# module load topas/4.2.3
# """

[server]

## Where the web interface listens.
##
## The default binds EVERY interface, which is what the shipped container needs to be
## reachable through `docker run -p`.  Authentication is [auth] below and is OFF BY DEFAULT,
## so on a default install anyone who can reach this port can read every study on the server:
## if a reverse proxy fronts PregDos, bind the loopback instead and let the proxy be the only
## way in.
# host = "0.0.0.0"

## TCP port.  Change it when something else already listens on 5000 -- PregDos binds all
## interfaces, so a clash is an immediate "Address already in use" at startup.
# port = 5000

## TLS for the built-in server: PEM certificate and its private key, BOTH or NEITHER.
## Setting only one is a startup error rather than a silent fall back to plain HTTP.
##
## This makes the DEVELOPMENT server speak HTTPS.  It is encryption, not a production
## deployment, and it is encryption rather than authentication -- [auth] below is the other
## half, and the two are checked together at startup: turning a login on over plain HTTP on a
## non-loopback address is a startup error.  A self-signed certificate also trains users to
## click through browser warnings, so prefer one from the site's own CA, and put a real WSGI
## server in front for anything beyond a trial.
##
## The key must be readable by the user running PregDos and by nobody else (0600).
# ssl_cert = ""
# ssl_key = ""

[auth]

## OPTIONAL LOGIN.  Off by default, which is exactly how PregDos has always behaved: no login
## page, no session, and anyone who can reach the port reads every study.  That is fine for
## the container and for a single-user workstation.  It is not fine for a shared host holding
## non-anonymized patient DICOM.
##
##   "none" - no authentication (the default)
##   "file" - a password file PregDos manages itself, written with `pregdos-passwd`.  Works
##            everywhere, including the container.  It also means a NEW password for every
##            user, which is the wrong answer at a site that already has a credential store.
##
## AUTHENTICATION IS NOT SEGREGATION.  Everyone who signs in sees every study and every
## patient; PregDos has no per-user ownership.  What a login buys is keeping strangers out
## and, with the audit log in the journal, a record of who saw what.
# method = "none"

## A NARROWING filter on top of the method, not the access list itself.  Empty -- the default
## -- means every account the backend accepts may sign in, which for "file" is exactly the
## set of accounts in the password file.  Set it only to admit fewer than that, e.g.
##
##     allow_users = ["nbassler", "oncall"]
##
## Setting it while method = "none" is a startup error: it would quietly do nothing, and the
## admin who wrote it would have every reason to think the server was protected.
# allow_users = []

## One line shown on the sign-in form saying WHICH password is being asked for.  At a site
## with more than one credential store this is the first support question people ask, so it
## is worth wording precisely -- name the actual share or server, and write it in the language
## the people typing it read.  Empty means the method's own default wording.
# login_hint = ""

## How long one sign-in lasts at most, and how long a tab may sit untouched before it is
## signed out.  The 5 s task-page poller deliberately does NOT count as activity, so a screen
## left unattended still times out.  idle_minutes = 0 disables the idle timeout; there is no
## way to express a session that never expires.
# session_hours = 12
# idle_minutes = 60

## Where method = "file" keeps its accounts.  Empty means $STATE_DIRECTORY/users, which
## systemd creates as /var/lib/pregdos (StateDirectory=pregdos in the shipped unit), or
## $XDG_STATE_HOME/pregdos/users outside systemd.  Manage it with `pregdos-passwd`, never by
## hand; it stores scrypt hashes, not passwords, and must stay 0600.
# password_file = ""

## Where the session-signing key is kept.  Empty means $STATE_DIRECTORY/secret_key, beside the
## password file.  It is generated 0600 on first start and MUST persist: a key that changes
## signs everybody out on every restart, and two worker processes with different keys reject
## each other's sessions.  $PREGDOS_SECRET_KEY still wins over both.
# secret_key_file = ""

## Allow a login over plain HTTP on a non-loopback address.  Normally a startup error, for the
## same reason half a TLS pair is: the password would cross the network in clear.  The one
## legitimate case is a container whose only route in is a proxy that terminates TLS.
# allow_insecure_http = false

[network]

## Whether /about may ask api.github.com whether a newer PregDos exists.  Set false on an
## airgapped site: the request can never succeed and costs a timeout on the first page load
## of each worker process.
# update_check = true
